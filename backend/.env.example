# ── Base de datos ────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bolivia_insight?schema=public"

# ── Auth / JWT ───────────────────────────────────────────────────
JWT_SECRET="change-me"

# ── Google OAuth + Calendar ──────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Gemini (AI Concierge) ────────────────────────────────────────
GEMINI_API_KEY=""

# ── Admin (web administrativa) ───────────────────────────────────
# Correos de Google autorizados para la web admin (coma-separado).
ADMIN_EMAILS=""

# ── Email (SMTP, confirmaciones de reserva) ──────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ── PayPal (Sandbox) ─────────────────────────────────────────────
# Crea una app en https://developer.paypal.com/dashboard/applications/sandbox
# Copia el Client ID y el Secret de esa app aquí.
# El Client ID es público (se envía al navegador); el Secret NUNCA sale del backend.
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET=""
PAYPAL_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CURRENCY="USD"
