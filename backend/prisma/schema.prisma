datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int       @id @default(autoincrement())
  googleId  String    @unique
  email     String    @unique
  name      String?
  picture   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Booking {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime
  timeSlot    String
  topic       String
  notes       String?
  status      String   @default("confirmed")
  calendarId  String?
  calendarLink String?

  // ── Sesión / precio ──────────────────────────────
  durationMin Int      @default(30)
  amount      Float    @default(0)
  currency    String   @default("USD")

  // ── Pago PayPal ──────────────────────────────────
  paypalOrderId   String?
  paypalCaptureId String?

  // ── Brief de preparación (obligatorio en el flujo) ─
  briefDates     String?
  briefRoute     String?
  briefQuestions String?
  briefLocation  String?

  createdAt   DateTime @default(now())
}

model Poi {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  category     String
  description  String?
  lat          Float
  lon          Float
  visitMinutes Int      @default(0)
  nodeId       String   @unique
  city         String   @default("la-paz")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([city])
}

model GraphNode {
  id        Int         @id @default(autoincrement())
  slug      String      @unique
  type      String
  lat       Float
  lon       Float
  city      String      @default("la-paz")
  edgesFrom GraphEdge[] @relation("FromNode")
  edgesTo   GraphEdge[] @relation("ToNode")

  @@index([city])
}

model GraphEdge {
  id            Int       @id @default(autoincrement())
  fromSlug      String
  toSlug        String
  minutes       Int
  mode          String
  line          String?
  bidirectional Boolean   @default(false)
  city          String    @default("la-paz")
  from          GraphNode @relation("FromNode", fields: [fromSlug], references: [slug])
  to            GraphNode @relation("ToNode",   fields: [toSlug],   references: [slug])

  @@index([fromSlug])
  @@index([toSlug])
  @@index([city])
}
